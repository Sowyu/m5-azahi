+/* Offline J714s experiment. Keep child-driver blacklists until attended tests. */
+static bool sram32;
+module_param(sram32, bool, 0444);
+MODULE_PARM_DESC(sram32, "Use 32-bit SMC SRAM transfers on J714s (experimental)");
+
+/* The negotiated key buffer is 4 KiB; protocol payloads are at most 255 bytes. */
+static void apple_smc_copy_fromio(void *dst, const void __iomem *src, size_t count)
+{
+	if (!sram32) {
+		memcpy_fromio(dst, src, count);
+		return;
+	}
+
+	while (count) {
+		size_t chunk = min_t(size_t, count, sizeof(u32));
+		u32 value = __raw_readl(src);
+
+		memcpy(dst, &value, chunk);
+		src += sizeof(value);
+		dst += chunk;
+		count -= chunk;
+	}
+}
+
+static void apple_smc_copy_toio(void __iomem *dst, const void *src, size_t count)
+{
+	if (!sram32) {
+		memcpy_toio(dst, src, count);
+		return;
+	}
+
+	while (count) {
+		size_t chunk = min_t(size_t, count, sizeof(u32));
+		u32 value = 0;
+
+		/* Apple also zero-pads the final partial word before its 32-bit write. */
+		memcpy(&value, src, chunk);
+		__raw_writel(value, dst);
+		dst += sizeof(value);
+		src += chunk;
+		count -= chunk;
+	}
+}
