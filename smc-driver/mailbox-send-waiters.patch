@@ -10,6 +10,7 @@
 
 #include <linux/device.h>
 #include <linux/types.h>
+#include <linux/wait.h>
 
 /* encodes a single 96bit message sent over the single channel */
 struct apple_mbox_msg {
@@ -29,7 +30,11 @@
 	spinlock_t rx_lock;
 	spinlock_t tx_lock;
 
-	struct completion tx_empty;
+	wait_queue_head_t tx_wait;
+	/* Protected by tx_lock; tx_seq is also read by the wait condition. */
+	unsigned long tx_seq;
+	unsigned int tx_waiters;
+	bool tx_irq_unmasked;
 
 	/** Receive callback for incoming messages */
 	void (*rx)(struct apple_mbox *mbox, struct apple_mbox_msg msg, void *cookie);
