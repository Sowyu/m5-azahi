+/* Resolve die-0 identity without changing power state. Fail on ambiguity. */
+uintptr_t pmgr_lookup_device_addr(const char *name)
+{
+    const struct pmgr_device *found = NULL;
+
+    if (!pmgr_initialized || !name || !name[0] || strlen(name) >= 0x10 ||
+        !pmgr_devices || !pmgr_ps_regs || !pmgr_ps_regs_len || pmgr_ps_regs_len % 12)
+        return 0;
+
+    for (size_t i = 0; i < pmgr_devices_len; i++) {
+        const struct pmgr_device *device = &pmgr_devices[i];
+        if (strncmp(device->name, name, sizeof(device->name)))
+            continue;
+        if (found || (device->flags & PMGR_FLAG_VIRTUAL))
+            return 0;
+        found = device;
+    }
+
+    return found ? pmgr_device_get_addr(0, found) : 0;
+}
