@@ -478,6 +492,22 @@
 	ret = dwc3_apple_setup_role_switch(appledwc);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to setup role switch\n");
+
+	/*
+	 * azahi: no SPMI SN201202x Type-C driver exists in this kernel, so the
+	 * role-switch cable event that would leave PROBE_PENDING never arrives.
+	 * For the fixed downstream test port bring the core up in host mode now
+	 * (same approach as the wallace T6040 force-host bring-up patch).
+	 */
+	if (device_property_read_bool(dev, "azahi,force-host-mode")) {
+		dev_info(dev, "azahi: forcing host mode at probe\n");
+		mutex_lock(&appledwc->lock);
+		ret = dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
+		mutex_unlock(&appledwc->lock);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret, "Failed forced host-mode init\n");
