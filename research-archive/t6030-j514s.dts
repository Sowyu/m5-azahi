		watchdog@3642b0000 {
			compatible = "apple,t6030-wdt", "apple,t8103-wdt";
			reg = <0x03 0x642b0000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x1e0 0x04>;
		};

		spmi@364714000 {
			compatible = "apple,t6030-spmi", "apple,t8103-spmi";
			reg = <0x03 0x64714000 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@b {
				compatible = "apple,chapel-pmic", "apple,spmi-nvmem";
				reg = <0x0b 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					pm-setting@2001 {
						reg = <0x2001 0x01>;
					};

					rtc-offset@2100 {
						reg = <0x2100 0x06>;
						phandle = <0x63>;
					};

					fault-shadow@867b {
						reg = <0x867b 0x10>;
					};

					socd@8b00 {
						reg = <0x8b00 0x400>;
					};

					boot-stage@f801 {
						reg = <0xf801 0x01>;
						phandle = <0x60>;
					};

					boot-error-count@f802,0 {
						reg = <0xf802 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x61>;
					};

					panic-count@f802,4 {
						reg = <0xf802 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x62>;
					};

					boot-error-stage@f803 {
						reg = <0xf803 0x01>;
					};

					shutdown-flag@f80f,3 {
						reg = <0xf80f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x5f>;
					};
				};
			};
		};

		mbox@36c408000 {
			compatible = "apple,t6030-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x03 0x6c408000 0x00 0x4000>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x22a 0x04 0x00 0x22b 0x04 0x00 0x22c 0x04 0x00 0x22d 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			phandle = <0x5e>;
		};

		smc@36c400000 {
			compatible = "apple,t6030-smc", "apple,t8103-smc";
			reg = <0x03 0x6c400000 0x00 0x4000 0x03 0x6de00000 0x00 0x100000>;
			reg-names = "smc", "sram";
			mboxes = <0x5e>;

			gpio@67500000 {
				compatible = "apple,smc-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x75>;
			};

			gpio@67700000 {
				compatible = "apple,smc-low-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x69>;
			};

			hwmon {
				compatible = "apple,smc-hwmon";

				power-PSTR {
					apple,key-id = "PSTR";
					label = "Total System Power";
				};

				power-PDTR {
					apple,key-id = "PDTR";
					label = "AC Input Power";
				};

				power-PMVR {
					apple,key-id = "PMVR";
					label = "3.8 V Rail Power";
				};

				temperature-TH0x {
					apple,key-id = "TH0x";
					label = "NAND Flash Temperature";
				};

				voltage-VD0R {
					apple,key-id = "VD0R";
					label = "Charger Input Voltage";
				};

				current-ID0R {
					apple,key-id = "ID0R";
					label = "AC Input Current";
				};

				fan-F0Ac {
					apple,key-id = "F0Ac";
					label = "Fan 1";
					apple,fan-minimum = "F0Mn";
					apple,fan-maximum = "F0Mx";
					apple,fan-target = "F0Tg";
					apple,fan-mode = "F0Md";
				};

				fan-F1Ac {
					apple,key-id = "F1Ac";
					label = "Fan 2";
					apple,fan-minimum = "F1Mn";
					apple,fan-maximum = "F1Mx";
					apple,fan-target = "F1Tg";
					apple,fan-mode = "F1Md";
				};

				power-PHPC {
					apple,key-id = "PHPC";
					label = "Heatpipe Power";
				};

				temperature-TB0T {
					apple,key-id = "TB0T";
					label = "Battery Hotspot";
				};

				temperature-TCHP {
					apple,key-id = "TCHP";
					label = "Charge Regulator Temp";
				};

				temperature-TW0P {
					apple,key-id = "TW0P";
					label = "WiFi/BT Module Temp";
				};

				voltage-SBAV {
					apple,key-id = "SBAV";
					label = "Battery Voltage";
				};
			};

			reboot {
				compatible = "apple,smc-reboot";
				nvmem-cells = <0x5f 0x60 0x61 0x62>;
				nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count";
			};

			rtc {
				compatible = "apple,smc-rtc";
				nvmem-cells = <0x63>;
				nvmem-cell-names = "rtc_offset";
			};
		};

		pinctrl@36c820000 {
			compatible = "apple,t6030-pinctrl", "apple,t8103-pinctrl";
			reg = <0x03 0x6c820000 0x00 0x4000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x64 0x00 0x00 0x12>;
			apple,npins = <0x12>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x221 0x04 0x00 0x222 0x04 0x00 0x223 0x04 0x00 0x224 0x04 0x00 0x225 0x04 0x00 0x226 0x04 0x00 0x227 0x04>;
			phandle = <0x64>;
		};

		pinctrl@374824000 {
			compatible = "apple,t6030-pinctrl", "apple,t8103-pinctrl";
