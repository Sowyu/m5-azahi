	aliases {
		bluetooth0 = "/soc/pcie@580000000/pci@0,0/bluetooth@0,1";
		serial0 = "/soc/serial@2892000000";
		wifi0 = "/soc/pcie@580000000/pci@0,0/wifi@0,0";
		nvram = "/soc/spi@289104000/flash@0/partitions/partition@700000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
			power-domains = <0x79>;
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x02 0x00>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <0x7a 0x00 0x9c40>;
			label = "kbd_backlight";
			function = "kbd_backlight";
			color = <0x00>;
			max-brightness = <0xff>;
			default-state = "keep";
		};
	};

	fixed-regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		startup-delay-us = <0x1388>;
		gpios = <0x18 0x1c 0x00>;
		enable-active-high;
		phandle = <0x17>;
	};

	sound {
		compatible = "apple,j514-macaudio", "apple,j314-macaudio", "apple,macaudio";
		model = "MacBook Pro J514";

		dai-link@0 {
			link-name = "Speakers";

			cpu {
				sound-dai = <0x7b 0x00 0x7b 0x01>;
			};

			codec {
				sound-dai = <0x7c 0x7d 0x7e 0x7f 0x80 0x81>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0x7b 0x02>;
			};

			codec {
				sound-dai = <0x82>;
			};
		};
	};
