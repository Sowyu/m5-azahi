/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "laptop";
	compatible = "apple,j514s", "apple,t6030", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M3 Pro, Nov 2023)";

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};

				core2 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x04>;
				};

				core4 {
					cpu = <0x05>;
				};

				core5 {
					cpu = <0x06>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x07>;
				};

				core1 {
					cpu = <0x08>;
				};

				core2 {
					cpu = <0x09>;
				};

				core3 {
					cpu = <0x0a>;
				};

				core4 {
					cpu = <0x0b>;
				};

				core5 {
					cpu = <0x0c>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x02>;
		};

		cpu@2 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x03>;
		};

		cpu@3 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x04>;
		};

		cpu@4 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x04>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x05>;
		};

		cpu@5 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x05>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x353>;
			performance-domains = <0x0f>;
			phandle = <0x06>;
		};

		cpu@10100 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x07>;
		};

		cpu@10101 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x08>;
		};

		cpu@10102 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x09>;
		};

		cpu@10103 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x0a>;
		};

		cpu@10104 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10104>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x0b>;
		};

		cpu@10105 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10105>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x0c>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x0d>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x10>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0e>;

		opp01 {
			opp-hz = <0x00 0x2c588a00>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1e14>;
		};

		opp02 {
			opp-hz = <0x00 0x3e3a2d00>;
			opp-level = <0x02>;
			clock-latency-ns = <0x52d0>;
		};

		opp03 {
			opp-hz = <0x00 0x57f9f900>;
			opp-level = <0x03>;
			clock-latency-ns = <0x6720>;
		};

		opp04 {
			opp-hz = <0x00 0x77729d00>;
			opp-level = <0x04>;
			clock-latency-ns = <0x9e34>;
		};

		opp05 {
			opp-hz = <0x00 0x872eef00>;
			opp-level = <0x05>;
			clock-latency-ns = <0xad70>;
		};

		opp06 {
			opp-hz = <0x00 0x91e98400>;
			opp-level = <0x06>;
			clock-latency-ns = <0xb860>;
		};

		opp07 {
			opp-hz = <0x00 0x9d5b3400>;
			opp-level = <0x07>;
			clock-latency-ns = <0xcb20>;
		};

		opp08 {
			opp-hz = <0x00 0xa3cb2700>;
			opp-level = <0x08>;
			clock-latency-ns = <0xcb20>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x11>;

		opp01 {
			opp-hz = <0x00 0x297c1e00>;
			opp-level = <0x01>;
			clock-latency-ns = <0x2198>;
		};

		opp02 {
			opp-hz = <0x00 0x41169900>;
			opp-level = <0x02>;
			clock-latency-ns = <0x490c>;
		};

		opp03 {
			opp-hz = <0x00 0x50d2eb00>;
			opp-level = <0x03>;
			clock-latency-ns = <0x50dc>;
		};

		opp04 {
			opp-hz = <0x00 0x5f210700>;
			opp-level = <0x04>;
			clock-latency-ns = <0x60e0>;
		};

		opp05 {
			opp-hz = <0x00 0x704b8f00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x77ec>;
		};

		opp06 {
			opp-hz = <0x00 0x81761700>;
			opp-level = <0x06>;
			clock-latency-ns = <0x8660>;
		};

		opp07 {
			opp-hz = <0x00 0x907b4e00>;
			opp-level = <0x07>;
			clock-latency-ns = <0x9ab0>;
		};

		opp08 {
			opp-hz = <0x00 0x9becfe00>;
			opp-level = <0x08>;
			clock-latency-ns = <0x9c40>;
		};

		opp09 {
			opp-hz = <0x00 0xa75eae00>;
			opp-level = <0x09>;
			clock-latency-ns = <0xa348>;
		};

		opp10 {
			opp-hz = <0x00 0xb2194300>;
			opp-level = <0x0a>;
			clock-latency-ns = <0xb0f4>;
		};

		opp11 {
			opp-hz = <0x00 0xbb65a200>;
			opp-level = <0x0b>;
			clock-latency-ns = <0xb66c>;
		};

		opp12 {
			opp-hz = <0x00 0xc3fae600>;
			opp-level = <0x0c>;
			clock-latency-ns = <0xc030>;
		};

		opp13 {
			opp-hz = <0x00 0xcbd90f00>;
			opp-level = <0x0d>;
			clock-latency-ns = <0xd28c>;
		};

		opp14 {
			opp-hz = <0x00 0xd5256e00>;
			opp-level = <0x0e>;
			clock-latency-ns = <0xd1c4>;
		};

		opp15 {
			opp-hz = <0x00 0xd801da00>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xd2f0>;
		};

		opp16 {
			opp-hz = <0x00 0xdd039700>;
			opp-level = <0x10>;
			clock-latency-ns = <0xd2f0>;
		};

		opp17 {
			opp-hz = <0x00 0xe14e3900>;
			opp-level = <0x11>;
			clock-latency-ns = <0xd354>;
		};

		opp18 {
			opp-hz = <0x00 0xe64ff600>;
			opp-level = <0x12>;
			clock-latency-ns = <0xd41c>;
		};

		opp19 {
			opp-hz = <0x00 0xec08ce00>;
			opp-level = <0x13>;
			clock-latency-ns = <0xe420>;
		};

		opp20 {
			opp-hz = <0x00 0xf1c1a600>;
			opp-level = <0x14>;
			clock-latency-ns = <0xe54c>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x13>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04 0x01 0x00 0x04 0x01 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x14>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x25>;
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x35a4e900>;
		phandle = <0x58>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		cpufreq@210e20000 {
			compatible = "apple,t6030-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x02 0x10e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0f>;
		};

		cpufreq@211e20000 {
			compatible = "apple,t6030-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x02 0x11e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x12>;
		};

		i2c@289014000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x89014000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x37a 0x04>;
			pinctrl-0 = <0x15>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x16>;
			status = "okay";

			codec@3a {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3a>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Tweeter";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x08>;
				ti,vmon-slot-no = <0x0a>;
				phandle = <0x7d>;
			};

			codec@38 {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x38>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Woofer 1";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x00>;
				ti,vmon-slot-no = <0x02>;
				ti,sdout-force-zero-mask = <0xf0f0f0>;
				phandle = <0x7c>;
			};

			codec@39 {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x39>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Left Woofer 2";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x10>;
				ti,vmon-slot-no = <0x12>;
				phandle = <0x7e>;
			};
		};

		i2c@289018000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x89018000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x37b 0x04>;
			pinctrl-0 = <0x19>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x1a>;
			status = "okay";

			codec@4b {
				compatible = "cirrus,cs42l84";
				reg = <0x4b>;
				reset-gpios = <0x1b 0x3a 0x00>;
				#sound-dai-cells = <0x00>;
				interrupts-extended = <0x18 0x1e 0x08>;
				sound-name-prefix = "Jack";
				phandle = <0x82>;
			};
		};

		i2c@28901c000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x8901c000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x37c 0x04>;
			pinctrl-0 = <0x1c>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x1d>;
			status = "okay";

			codec@3d {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3d>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Tweeter";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x0c>;
				ti,vmon-slot-no = <0x0e>;
				phandle = <0x80>;
			};

			codec@3b {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3b>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Woofer 1";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x04>;
				ti,vmon-slot-no = <0x06>;
				ti,sdout-force-zero-mask = <0xf0f0f>;
				phandle = <0x7f>;
			};

			codec@3c {
				compatible = "ti,sn012776", "ti,tas2764";
				reg = <0x3c>;
				SDZ-supply = <0x17>;
				#sound-dai-cells = <0x00>;
				sound-name-prefix = "Right Woofer 2";
				interrupts-extended = <0x18 0x1d 0x08>;
				ti,imon-slot-no = <0x14>;
				ti,vmon-slot-no = <0x16>;
				phandle = <0x81>;
			};
		};

		i2c@289020000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x89020000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x37d 0x04>;
			pinctrl-0 = <0x1e>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x1f>;
			status = "disabled";
		};

		i2c@289028000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x89028000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x37f 0x04>;
			pinctrl-0 = <0x20>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x21>;
			status = "disabled";
		};

		i2c@289030000 {
			compatible = "apple,t6030-i2c", "apple,t8103-i2c";
			reg = <0x02 0x89030000 0x00 0x4000>;
			clocks = <0x14>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x381 0x04>;
			pinctrl-0 = <0x22>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			power-domains = <0x23>;
			status = "disabled";
		};

		pwm@289040000 {
			compatible = "apple,t6030-fpwm", "apple,s5l-fpwm";
			reg = <0x02 0x89040000 0x00 0x4000>;
			power-domains = <0x24>;
			clocks = <0x14>;
			#pwm-cells = <0x02>;
			status = "okay";
			phandle = <0x7a>;
		};

		spi@289104000 {
			compatible = "apple,t6030-spi", "apple,t8103-spi";
			reg = <0x02 0x89104000 0x00 0x4000>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x36b 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x25>;
			pinctrl-0 = <0x26>;
			pinctrl-names = "default";
			power-domains = <0x27>;
			status = "okay";

			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0x00>;
				spi-max-frequency = <0x17d7840>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					partition@700000 {
						label = "nvram";
