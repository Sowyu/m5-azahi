/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "apple,j514c", "apple,t6031", "apple,arm-platform";
	chassis-type = "laptop";
	model = "Apple MacBook Pro (14-inch, M3 Max, 16 CPU cores, Nov 2023)";

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};

				core2 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};

				core4 {
					cpu = <0x09>;
				};

				core5 {
					cpu = <0x0a>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};

				core2 {
					cpu = <0x0d>;
				};

				core3 {
					cpu = <0x0e>;
				};

				core4 {
					cpu = <0x0f>;
				};

				core5 {
					cpu = <0x10>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x366>;
			performance-domains = <0x13>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x366>;
			performance-domains = <0x13>;
			phandle = <0x02>;
		};

		cpu@2 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x366>;
			performance-domains = <0x13>;
			phandle = <0x03>;
		};

		cpu@3 {
			compatible = "apple,sawtooth";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x366>;
			performance-domains = <0x13>;
			phandle = <0x04>;
		};

		cpu@10100 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x05>;
		};

		cpu@10101 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x06>;
		};

		cpu@10102 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x07>;
		};

		cpu@10103 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x08>;
		};

		cpu@10104 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10104>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x09>;
		};

		cpu@10105 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10105>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x14>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x16>;
			phandle = <0x0a>;
		};

		cpu@10200 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10200>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x0b>;
		};

		cpu@10201 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10201>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x0c>;
		};

		cpu@10202 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10202>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x0d>;
		};

		cpu@10203 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10203>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x0e>;
		};

		cpu@10204 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10204>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x0f>;
		};

		cpu@10205 {
			compatible = "apple,everest";
			device_type = "cpu";
			reg = <0x00 0x10205>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x17>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x15>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x18>;
			phandle = <0x10>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x11>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x14>;
		};

		l2-cache-2 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x17>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x12>;

		opp01 {
			opp-hz = <0x00 0x3ccbf700>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1c20>;
		};

		opp02 {
			opp-hz = <0x00 0x4ead9a00>;
			opp-level = <0x02>;
			clock-latency-ns = <0x55f0>;
		};

		opp03 {
			opp-hz = <0x00 0x6590fa00>;
			opp-level = <0x03>;
			clock-latency-ns = <0x6d60>;
		};

		opp04 {
			opp-hz = <0x00 0x7c745a00>;
			opp-level = <0x04>;
			clock-latency-ns = <0x9470>;
		};

		opp05 {
			opp-hz = <0x00 0x940ed500>;
			opp-level = <0x05>;
			clock-latency-ns = <0xb3b0>;
		};

		opp06 {
			opp-hz = <0x00 0x99109200>;
			opp-level = <0x06>;
			clock-latency-ns = <0xb3b0>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x15>;

		opp02 {
			opp-hz = <0x00 0x41169900>;
			opp-level = <0x02>;
			clock-latency-ns = <0x1c20>;
		};

		opp03 {
			opp-hz = <0x00 0x50d2eb00>;
			opp-level = <0x03>;
			clock-latency-ns = <0x4a38>;
		};

		opp04 {
			opp-hz = <0x00 0x5f210700>;
			opp-level = <0x04>;
			clock-latency-ns = <0x4e20>;
		};

		opp05 {
			opp-hz = <0x00 0x704b8f00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x55f0>;
		};

		opp06 {
			opp-hz = <0x00 0x81761700>;
			opp-level = <0x06>;
			clock-latency-ns = <0x7530>;
		};

		opp07 {
			opp-hz = <0x00 0x907b4e00>;
			opp-level = <0x07>;
			clock-latency-ns = <0x84d0>;
		};

		opp08 {
			opp-hz = <0x00 0x9becfe00>;
			opp-level = <0x08>;
			clock-latency-ns = <0x9088>;
		};

		opp09 {
			opp-hz = <0x00 0xa75eae00>;
			opp-level = <0x09>;
			clock-latency-ns = <0x9470>;
		};

		opp10 {
			opp-hz = <0x00 0xb2194300>;
			opp-level = <0x0a>;
			clock-latency-ns = <0x9c40>;
		};

		opp11 {
			opp-hz = <0x00 0xbb65a200>;
			opp-level = <0x0b>;
			clock-latency-ns = <0xa028>;
		};

		opp12 {
			opp-hz = <0x00 0xc3fae600>;
			opp-level = <0x0c>;
			clock-latency-ns = <0xa7f8>;
		};

		opp13 {
			opp-hz = <0x00 0xcbd90f00>;
			opp-level = <0x0d>;
			clock-latency-ns = <0xabe0>;
		};

		opp14 {
			opp-hz = <0x00 0xd191e700>;
			opp-level = <0x0e>;
			clock-latency-ns = <0xb3b0>;
		};

		opp15 {
			opp-hz = <0x00 0xd5256e00>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xb3b0>;
		};

		opp16 {
			opp-hz = <0x00 0xd801da00>;
			opp-level = <0x10>;
			clock-latency-ns = <0xb3b0>;
		};

		opp17 {
			opp-hz = <0x00 0xdd039700>;
			opp-level = <0x11>;
			clock-latency-ns = <0xb3b0>;
		};

		opp18 {
			opp-hz = <0x00 0xe14e3900>;
			opp-level = <0x12>;
			clock-latency-ns = <0xafc8>;
		};

		opp19 {
			opp-hz = <0x00 0xe64ff600>;
			opp-level = <0x13>;
			clock-latency-ns = <0xafc8>;
		};

		opp20 {
			opp-hz = <0x00 0xec08ce00>;
			opp-level = <0x14>;
			clock-latency-ns = <0xd2f0>;
		};

		opp21 {
			opp-hz = <0x00 0xf1c1a600>;
			opp-level = <0x15>;
			clock-latency-ns = <0xd2f0>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x19>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x00 0x02 0x04 0x01 0x00 0x03 0x04 0x01 0x00 0x00 0x04 0x01 0x00 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x1b>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x3f>;
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x35a4e900>;
		phandle = <0x1a>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		clock-controller@29003c000 {
			compatible = "apple,t6031-nco", "apple,t8103-nco";
			reg = <0x02 0x9003c000 0x00 0x14000>;
			clocks = <0x1a>;
			#clock-cells = <0x01>;
			phandle = <0x46>;
		};

		watchdog@2a02d4000 {
			compatible = "apple,t6031-wdt", "apple,t8103-wdt";
			reg = <0x02 0xa02d4000 0x00 0x4000>;
			clocks = <0x1b>;
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x2ce 0x04>;
		};

		interrupt-controller@292400000 {
			compatible = "apple,t6031-aic3", "apple,t8122-aic3";
			#interrupt-cells = <0x04>;
			interrupt-controller;
			reg = <0x02 0x92400000 0x00 0x1cc000 0x02 0x92440000 0x00 0x4000>;
			reg-names = "core", "event";
			power-domains = <0x1c>;
			phandle = <0x19>;
		};

		spmi@2a1014000 {
			compatible = "apple,t6031-spmi", "apple,t8103-spmi";
			reg = <0x02 0xa1014000 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@b {
				compatible = "apple,chapel-pmic", "apple,spmi-nvmem";
				reg = <0x0b 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					pm-setting@2001 {
						reg = <0x2001 0x01>;
					};

					rtc-offset@2100 {
						reg = <0x2100 0x06>;
						phandle = <0x22>;
					};

					fault-shadow@867b {
						reg = <0x867b 0x10>;
					};

					socd@8b00 {
						reg = <0x8b00 0x400>;
					};

					boot-stage@f801 {
						reg = <0xf801 0x01>;
						phandle = <0x1f>;
					};

					boot-error-count@f802,0 {
						reg = <0xf802 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x20>;
					};

					panic-count@f802,4 {
						reg = <0xf802 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x21>;
					};

					boot-error-stage@f803 {
						reg = <0xf803 0x01>;
					};

					shutdown-flag@f80f,3 {
						reg = <0xf80f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x1e>;
					};
				};
			};
		};

		mbox@2a4408000 {
			compatible = "apple,t6031-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0xa4408000 0x00 0x4000>;
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x393 0x04 0x00 0x00 0x394 0x04 0x00 0x00 0x395 0x04 0x00 0x00 0x396 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			phandle = <0x1d>;
		};

		smc@2a4400000 {
			compatible = "apple,t6031-smc", "apple,t8103-smc";
			reg = <0x02 0xa4400000 0x00 0x4000 0x02 0xa5e00000 0x00 0x100000>;
			reg-names = "smc", "sram";
			mboxes = <0x1d>;

			gpio@67500000 {
				compatible = "apple,smc-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x54>;
			};

			gpio@67700000 {
				compatible = "apple,smc-low-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x28>;
			};

			hwmon {
				compatible = "apple,smc-hwmon";

				power-PSTR {
					apple,key-id = "PSTR";
					label = "Total System Power";
				};

				power-PDTR {
					apple,key-id = "PDTR";
					label = "AC Input Power";
				};

				power-PMVR {
					apple,key-id = "PMVR";
					label = "3.8 V Rail Power";
				};

				temperature-TH0x {
					apple,key-id = "TH0x";
					label = "NAND Flash Temperature";
				};

				voltage-VD0R {
					apple,key-id = "VD0R";
					label = "Charger Input Voltage";
				};

				current-ID0R {
					apple,key-id = "ID0R";
					label = "AC Input Current";
				};

				fan-F0Ac {
					apple,key-id = "F0Ac";
					label = "Fan 1";
					apple,fan-minimum = "F0Mn";
					apple,fan-maximum = "F0Mx";
					apple,fan-target = "F0Tg";
					apple,fan-mode = "F0Md";
				};

				fan-F1Ac {
					apple,key-id = "F1Ac";
					label = "Fan 2";
					apple,fan-minimum = "F1Mn";
					apple,fan-maximum = "F1Mx";
					apple,fan-target = "F1Tg";
					apple,fan-mode = "F1Md";
				};

				power-PHPC {
					apple,key-id = "PHPC";
					label = "Heatpipe Power";
				};

				temperature-TB0T {
					apple,key-id = "TB0T";
					label = "Battery Hotspot";
				};

				temperature-TCHP {
					apple,key-id = "TCHP";
					label = "Charge Regulator Temp";
				};

				temperature-TW0P {
					apple,key-id = "TW0P";
					label = "WiFi/BT Module Temp";
				};

				voltage-SBAV {
					apple,key-id = "SBAV";
					label = "Battery Voltage";
				};
			};

			reboot {
				compatible = "apple,smc-reboot";
				nvmem-cells = <0x1e 0x1f 0x20 0x21>;
