		iommu@391004000 {
			compatible = "apple,t6031-dart", "apple,t8110-dart";
			reg = <0x03 0x91004000 0x00 0x4000>;
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x53a 0x04>;
			#iommu-cells = <0x01>;
			power-domains = <0x63>;
			phandle = <0x43>;
		};

		pinctrl@2b3000000 {
			compatible = "apple,t6031-pinctrl", "apple,t8103-pinctrl", "apple,pinctrl";
			reg = <0x02 0xb3000000 0x00 0x4000>;
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x1ca 0x04 0x00 0x00 0x1cb 0x04 0x00 0x00 0x1cc 0x04 0x00 0x00 0x1cd 0x04 0x00 0x00 0x1ce 0x04 0x00 0x00 0x1cf 0x04 0x00 0x00 0x1d0 0x04>;
			clocks = <0x1b>;
			power-domains = <0xac>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x2e 0x00 0x00 0xc8>;
			apple,npins = <0xc8>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x2e>;

			i2c0-pins {
				pinmux = <0x10038 0x10039>;
				phandle = <0x29>;
			};

			i2c1-pins {
				pinmux = <0x1003a 0x1003b>;
				phandle = <0x2b>;
			};

			i2c2-pins {
				pinmux = <0x1003c 0x1003d>;
				phandle = <0x2f>;
			};

			i2c3-pins {
				pinmux = <0x1003e 0x1003f>;
				phandle = <0x32>;
			};

			i2c4-pins {
				pinmux = <0x10040 0x10041>;
				phandle = <0x34>;
			};

			i2c5-pins {
				pinmux = <0x10042 0x10043>;
				phandle = <0x36>;
			};

			i2c6-pins {
				pinmux = <0x10044 0x10045>;
				phandle = <0x38>;
			};

			i2c7-pins {
				pinmux = <0x10046 0x10047>;
				phandle = <0x3a>;
			};

			i2c8-pins {
				pinmux = <0x10048 0x10049>;
				phandle = <0x3c>;
			};

			spi1-pins {
				pinmux = <0x10074 0x10075 0x10076 0x10077>;
				phandle = <0x40>;
			};

			pcie-pins {
				pinmux = <0x10000 0x10001 0x10002 0x10003>;
				phandle = <0x52>;
			};
		};

		power-management@408e80000 {
			compatible = "apple,t6031-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x04 0x8e80000 0x00 0x4000>;

			power-controller@0 {
				compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x00 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "gpx";
				apple,always-on;
			};

			power-controller@100 {
				compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "afr";
				apple,always-on;
				phandle = <0xad>;
			};

			power-controller@110 {
				compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x110 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "gfx";
				power-domains = <0xad>;
			};
		};

		mbox@349408000 {
			compatible = "apple,t6031-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x03 0x49408000 0x00 0x4000>;
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x4fa 0x04 0x00 0x00 0x4fb 0x04 0x00 0x00 0x4fc 0x04 0x00 0x00 0x4fd 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			power-domains = <0x72>;
			#mbox-cells = <0x00>;
			phandle = <0xae>;
		};

		sart@34dc50000 {
			compatible = "apple,t6031-sart", "apple,t6000-sart";
			reg = <0x03 0x4dc50000 0x00 0x10000>;
			power-domains = <0x72>;
			phandle = <0xaf>;
		};

		nvme@34dcc0000 {
			compatible = "apple,t6031-nvme-ans2", "apple,t8103-nvme-ans2";
			reg = <0x03 0x4dcc0000 0x00 0x40000 0x03 0x49400000 0x00 0x4000>;
			reg-names = "nvme", "ans";
			interrupt-parent = <0x19>;
			interrupts = <0x00 0x00 0x93e 0x04>;
			mboxes = <0xae>;
			apple,sart = <0xaf>;
			power-domains = <0x72 0xb0 0xb1>;
			power-domain-names = "ans", "apcie0", "apcie1";
			resets = <0x72>;
		};
	};

	aliases {
		bluetooth0 = "/soc/pcie@580000000/pci@0,0/bluetooth@0,1";
		serial0 = "/soc/serial@391200000";
		wifi0 = "/soc/pcie@580000000/pci@0,0/wifi@0,0";
		nvram = "/soc/spi@391104000/flash@0/partitions/partition@700000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
			power-domains = <0xb2>;
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x02 0x00>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <0xb3 0x00 0x9c40>;
			label = "kbd_backlight";
			function = "kbd_backlight";
			color = <0x00>;
			max-brightness = <0xff>;
			default-state = "keep";
		};
	};

	fixed-regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		startup-delay-us = <0x1388>;
		gpios = <0x2e 0x1c 0x00>;
		enable-active-high;
		phandle = <0x2d>;
	};

	sound {
		compatible = "apple,j514-macaudio", "apple,j314-macaudio", "apple,macaudio";
		model = "MacBook Pro J514";

		dai-link@0 {
			link-name = "Speakers";

			cpu {
				sound-dai = <0xb4 0x00 0xb4 0x01>;
			};

			codec {
				sound-dai = <0xb5 0xb6 0xb7 0xb8 0xb9 0xba>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xb4 0x02>;
			};

			codec {
				sound-dai = <0xbb>;
			};
		};
	};
};
