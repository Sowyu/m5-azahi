/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "apple,j314s", "apple,t6000", "apple,arm-platform";
	chassis-type = "laptop";
	model = "Apple MacBook Pro (14-inch, M1 Pro, 2021)";

	aliases {
		gpu = "/soc/gpu@406400000";
		atcphy0 = "/soc/phy@703000000";
		atcphy1 = "/soc/phy@b03000000";
		atcphy2 = "/soc/phy@f03000000";
		atcphy3 = "/soc/phy@1303000000";
		bluetooth0 = "/soc/pcie@590000000/pci@0,0/bluetooth@0,1";
		dcp = "/soc/dcp@38bc00000";
		dcpext0 = "/soc/dcp@289c00000";
		disp0 = "/soc/display-subsystem";
		disp0_piodma = "/soc/dcp@38bc00000/piodma";
		serial0 = "/soc/serial@39b200000";
		sio = "/soc/sio@39bc00000";
		wifi0 = "/soc/pcie@590000000/pci@0,0/wifi@0,0";
		nvram = "/soc/spi@39b104000/flash@0/partitions/partition@700000";
		isp = "/soc/isp@384000000";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x03>;
				};

				core1 {
					cpu = <0x04>;
				};

				core2 {
					cpu = <0x05>;
				};

				core3 {
					cpu = <0x06>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x07>;
				};

				core1 {
					cpu = <0x08>;
				};

				core2 {
					cpu = <0x09>;
				};

				core3 {
					cpu = <0x0a>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0d>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0d>;
			phandle = <0x02>;
		};

		cpu@10100 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x10>;
			phandle = <0x03>;
		};

		cpu@10101 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x10>;
			phandle = <0x04>;
		};

		cpu@10102 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x10>;
			phandle = <0x05>;
		};

		cpu@10103 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x10>;
			phandle = <0x06>;
		};

		cpu@10200 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10200>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x07>;
		};

		cpu@10201 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10201>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x08>;
		};

		cpu@10202 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10202>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x09>;
		};

		cpu@10203 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10203>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x11>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x0f>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x0a>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x0b>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0xc00000>;
			phandle = <0x0e>;
		};

		l2-cache-2 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0xc00000>;
			phandle = <0x11>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		phandle = <0x0c>;

		opp01 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1d4c>;
			opp-microwatt = <0xb8c0>;
		};

		opp02 {
			opp-hz = <0x00 0x39ef8b00>;
			opp-level = <0x02>;
			clock-latency-ns = <0x59d8>;
			opp-microwatt = <0x18583>;
		};

		opp03 {
			opp-hz = <0x00 0x4f64b500>;
			opp-level = <0x03>;
			clock-latency-ns = <0x7148>;
			opp-microwatt = <0x2e1bc>;
		};

		opp04 {
			opp-hz = <0x00 0x6590fa00>;
			opp-level = <0x04>;
			clock-latency-ns = <0x9c40>;
			opp-microwatt = <0x4687b>;
		};

		opp05 {
			opp-hz = <0x00 0x7b062400>;
			opp-level = <0x05>;
			clock-latency-ns = <0xc350>;
			opp-microwatt = <0x64d33>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x0f>;

		opp01 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1f40>;
			opp-microwatt = <0x46db6>;
		};

		opp02 {
			opp-hz = <0x00 0x315a4700>;
			opp-level = <0x02>;
			clock-latency-ns = <0x4650>;
			opp-microwatt = <0x6d9f5>;
		};

		opp03 {
			opp-hz = <0x00 0x3ef14800>;
			opp-level = <0x03>;
			clock-latency-ns = <0x4a38>;
			opp-microwatt = <0x9dfb9>;
		};

		opp04 {
			opp-hz = <0x00 0x4d3f6400>;
			opp-level = <0x04>;
			clock-latency-ns = <0x59d8>;
			opp-microwatt = <0xd3554>;
		};

		opp05 {
			opp-hz = <0x00 0x5ad66500>;
			opp-level = <0x05>;
			clock-latency-ns = <0x5dc0>;
			opp-microwatt = <0x10fb06>;
		};

		opp06 {
			opp-hz = <0x00 0x686d6600>;
			opp-level = <0x06>;
			clock-latency-ns = <0x6d60>;
			opp-microwatt = <0x162cd7>;
		};

		opp07 {
			opp-hz = <0x00 0x76046700>;
			opp-level = <0x07>;
			clock-latency-ns = <0x7918>;
			opp-microwatt = <0x1b1c1b>;
		};

		opp08 {
			opp-hz = <0x00 0x839b6800>;
			opp-level = <0x08>;
			clock-latency-ns = <0xafc8>;
			opp-microwatt = <0x241ce2>;
		};

		opp09 {
			opp-hz = <0x00 0x91e98400>;
			opp-level = <0x09>;
			clock-latency-ns = <0xbf68>;
			opp-microwatt = <0x2c21a1>;
		};

		opp10 {
			opp-hz = <0x00 0x9f808500>;
			opp-level = <0x0a>;
			clock-latency-ns = <0xcf08>;
			opp-microwatt = <0x3507d9>;
		};

		opp11 {
			opp-hz = <0x00 0xad178600>;
			opp-level = <0x0b>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x3c6a72>;
		};

		opp12 {
			opp-hz = <0x00 0xb4f5af00>;
			opp-level = <0x0c>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x4548cc>;
		};

		opp13 {
			opp-hz = <0x00 0xbaae8700>;
			opp-level = <0x0d>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x486747>;
			turbo-mode;
		};

		opp14 {
			opp-hz = <0x00 0xbcd3d800>;
			opp-level = <0x0e>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x499576>;
			turbo-mode;
		};

		opp15 {
			opp-hz = <0x00 0xc0675f00>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x4b8d1c>;
			turbo-mode;
		};
	};

	opp-table-gpu {
		compatible = "operating-points-v2";
		phandle = <0x6e>;

		opp00 {
			opp-hz = <0x00 0x00>;
			opp-microvolt = <0x61a80 0x61a80>;
			opp-microwatt = <0x00>;
		};

		opp01 {
			opp-hz = <0x00 0x172c9e00>;
			opp-microvolt = <0x9ac90 0x9ac90>;
			opp-microwatt = <0x17da4fa>;
		};

		opp02 {
			opp-hz = <0x00 0x1cf7c580>;
			opp-microvolt = <0x9eb10 0x9eb10>;
			opp-microwatt = <0x1e36a92>;
		};

		opp03 {
			opp-hz = <0x00 0x269fb200>;
			opp-microvolt = <0xa3160 0xa3160>;
			opp-microwatt = <0x27c12f6>;
		};

		opp04 {
			opp-hz = <0x00 0x2e593c00>;
			opp-microvolt = <0xae8f8 0xae8f8>;
			opp-microwatt = <0x3610f8c>;
		};

		opp05 {
			opp-hz = <0x00 0x39ef8b00>;
			opp-microvolt = <0xbdf10 0xbdf10>;
			opp-microwatt = <0x4f825ec>;
		};

		opp06 {
			opp-hz = <0x00 0x4d3f6400>;
			opp-microvolt = <0xdc758 0xdc758>;
			opp-microwatt = <0x9f04bd8>;
		};
	};

	pmu-e {
		compatible = "apple,icestorm-pmu";
		interrupt-parent = <0x13>;
		interrupts = <0x01 0x00 0x04 0x04>;
	};

	pmu-p {
		compatible = "apple,firestorm-pmu";
		interrupt-parent = <0x13>;
		interrupts = <0x01 0x00 0x05 0x04>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x13>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x00 0x02 0x04 0x01 0x00 0x03 0x04 0x01 0x00 0x00 0x04 0x01 0x00 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x2c>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x56>;
	};

	clock-disp0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xe256b50>;
		clock-output-names = "clk_disp0";
		phandle = <0x39>;
	};

	clock-dispext0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext0";
		phandle = <0x8a>;
	};

	clock-dispext0_die1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext0_die1";
	};

	clock-dispext1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext1";
		phandle = <0x92>;
	};

	clock-dispext1_die1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext1_die1";
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x3fa86300>;
		phandle = <0x14>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		globals {
			status = "disabled";
			phandle = <0x6d>;
		};

		hw-cal-a {
			status = "disabled";
			phandle = <0x6b>;
		};

		hw-cal-b {
			status = "disabled";
			phandle = <0x6c>;
		};

		uat-handoff {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x6a>;
		};

		uat-pagetables {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x69>;
		};

		uat-ttbs {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x68>;
		};

		isp-heap {
			compatible = "apple,asc-mem";
			reg = <0x00 0x00 0x00 0x00>;
			no-map;
			phandle = <0x7b>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		clock-controller@28e03c000 {
			compatible = "apple,t6000-nco", "apple,nco";
			reg = <0x02 0x8e03c000 0x00 0x14000>;
			clocks = <0x14>;
			#clock-cells = <0x01>;
			phandle = <0x60>;
		};

		interrupt-controller@28e100000 {
			compatible = "apple,t6000-aic", "apple,aic2";
			#interrupt-cells = <0x04>;
			interrupt-controller;
			reg = <0x02 0x8e100000 0x00 0xc000 0x02 0x8e10c000 0x00 0x04>;
			reg-names = "core", "event";
			power-domains = <0x15>;
			phandle = <0x13>;

			affinities {

				e-core-pmu-affinity {
					apple,fiq-index = <0x04>;
					cpus = <0x01 0x02>;
				};

				p-core-pmu-affinity {
					apple,fiq-index = <0x05>;
					cpus = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
				};
			};
		};

		power-management@28e20c000 {
			compatible = "apple,t6000-pmgr-misc";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0x8e20c000 0x00 0x400 0x02 0x8e20c800 0x00 0x400>;
			reg-names = "fabric-ps", "dcs-ps";
			apple,dcs-min-ps = <0x07>;
		};

		iommu@28e300000 {
			compatible = "apple,t6000-dart";
			reg = <0x02 0x8e300000 0x00 0x4000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x13>;
			interrupts = <0x00 0x00 0x3f2 0x04>;
			power-domains = <0x16>;
			phandle = <0x23>;
		};

		pmp_report@28e3c0000 {
			compatible = "apple,t6000-pmp-v2-report";
			reg = <0x02 0x8e3c0000 0x00 0x20000>;
			power-domains = <0x17>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			report@a {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x0a>;
				label = "pmp-ane-sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x18>;
				status = "disabled";
			};

			report@b {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x0b>;
				label = "pmp-isp-sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x19>;
				status = "okay";
			};

			report@c {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x0c>;
				label = "pmp-disp0";
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				apple,always-on;
			};

			report@d {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x0d>;
				label = "pmp-dispext0";
				#power-domain-cells = <0x00>;
				power-domains = <0x1b>;
				apple,always-on;
			};

			report@e {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x0e>;
				label = "pmp-dispext1";
				#power-domain-cells = <0x00>;
				power-domains = <0x1c>;
			};

			report@10 {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x10>;
				label = "pmp-venc-sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				status = "disabled";
			};

			report@11 {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x11>;
				label = "pmp-avd-sys";
				#power-domain-cells = <0x00>;
				power-domains = <0x1e>;
				status = "disabled";
			};

			report@12 {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x12>;
				label = "pmp-msr0";
				#power-domain-cells = <0x00>;
				power-domains = <0x1f>;
				status = "disabled";
			};

			report@13 {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x13>;
				label = "pmp-jpg";
				#power-domain-cells = <0x00>;
				power-domains = <0x20>;
				status = "disabled";
			};

			report@14 {
				compatible = "apple,t6000-pmp-v2-report-entry";
				reg = <0x14>;
				label = "pmp-scodec";
				#power-domain-cells = <0x00>;
