		regulator-name = "sn012776-sdz";
		startup-delay-us = <0x1388>;
		gpios = <0x43 0xb2 0x00>;
		enable-active-high;
		phandle = <0x4c>;
	};

	sound {
		compatible = "apple,j314-macaudio", "apple,macaudio";
		model = "MacBook Pro J314";

		dai-link@0 {
			link-name = "Speakers";

			cpu {
				sound-dai = <0xee 0x00 0xee 0x01>;
			};

			codec {
				sound-dai = <0xef 0xf0 0xf1 0xf2 0xf3 0xf4>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xee 0x02>;
			};

			codec {
				sound-dai = <0xf5>;
			};
		};
	};
};
