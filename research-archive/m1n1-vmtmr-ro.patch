+/*
+ * T6050 (Sotra): SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2 is read-only — MRS works,
+ * MSR takes an UNDEF (ESR EC=0) at EL2. Its reset value is 0xf (all FIQ
+ * delivery enabled), so guest timer FIQs still reach EL2; what we lose is
+ * the ability to *mask* a pending guest timer while the guest handles the
+ * injected vFIQ. Without masking, the still-asserted physical FIQ retriggers
+ * into EL2 on every eret and the guest livelocks at its first timer tick.
+ *
+ * Workaround: mask by injecting CNTx_CTL_IMASK into the guest timer's EL02
+ * CTL register instead (architectural, kills the FIQ output just as well),
+ * and hide the injected bit from the guest's trapped CTL reads. All guest
+ * timer sysreg accesses already trap here (CNTHCTL EL1TVT set / EL1PTEN
+ * clear, see hv_init), so the guest never sees a CTL value we didn't show it.
+ */
+static bool vm_tmr_fiq_ena_ro(void)
+{
+    return chip_id == T6050 || chip_id == T6051;
+}
+
+#define HV_VM_TMR_UPDATE(ctl_reg, flag)                                                            \
+    ({                                                                                             \
+        u64 ctl = mrs(ctl_reg);                                                                    \
+        u64 gctl = PERCPU(flag) ? ctl & ~CNTx_CTL_IMASK : ctl;                                     \
+        bool pend = gctl == (CNTx_CTL_ISTATUS | CNTx_CTL_ENABLE);                                  \
+        if (pend && !(ctl & CNTx_CTL_IMASK)) {                                                     \
+            msr(ctl_reg, ctl | CNTx_CTL_IMASK);                                                    \
+            PERCPU(flag) = true;                                                                   \
+        } else if (!pend && PERCPU(flag)) {                                                        \
+            msr(ctl_reg, ctl & ~CNTx_CTL_IMASK);                                                   \
+            PERCPU(flag) = false;                                                                  \
+        }                                                                                          \
+        pend;                                                                                      \
+    })
