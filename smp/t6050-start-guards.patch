+/* T6050 has three six-core clusters. CPU_START uses a linear bit per core,
+ * as recorded in the ADT function-enable_core arguments, not a four-core stride.
+ * Keep the legacy formula unchanged on other chips.
+ */
+static u32 smp_core_mask(int cluster, int core)
+{
+    if (cluster < 0 || core < 0)
+        return 0;
+    unsigned bit;
+    if (chip_id == T6050) {
+        if (cluster >= 3 || core >= 6)
+            return 0;
+        bit = 6U * cluster + core;
+    } else {
+        if (cluster >= 8 || core >= 32 - 4 * cluster)
+            return 0;
+        bit = 4U * cluster + core;
+    }
+    return 1U << bit;
+}
+
+/* A delayed T6050 core can still consume target_cpu and the reset stack.
+ * Keep both intact, and prevent another start or handoff until a power cycle.
+ * panic() is unsuitable here because it reboots into the retained state.
+ */
+static __attribute__((noreturn)) void smp_start_quarantine(int index)
+{
+    printf("AZAHI_SMP_STOP: CPU %d timed out; reset context retained; power cycle required\n",
+           index);
+    sysop("dsb sy");
+    for (;;)
+        sysop("wfe");
+}
